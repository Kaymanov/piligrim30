# Database Settings
POSTGRES_DB=piligrim_db
POSTGRES_USER=piligrim_user
POSTGRES_PASSWORD=piligrim_pass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Django Settings
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Redis
REDIS_URL=redis://redis:6379/0

# Email Settings (for lead notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
LEAD_NOTIFICATION_EMAIL=your-email@gmail.com

# AI Lawyer (Polza.ai — OpenAI-compatible)
POLZA_API_KEY=your-polza-api-key
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_MODEL=google/gemma-4-26b-a4b-it

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_SITE_URL=https://test.piligrim30.ru

# Runtime SEO switch. Only SITE_URL=https://piligrim30.ru permits indexing.
SITE_URL=https://test.piligrim30.ru

# Optional IndexNow ownership key (public verification token, 8–128 chars).
# Set the same key in frontend and backend, then enable IndexNow in Django admin.
INDEXNOW_KEY=

# Internal URL the frontend container uses for server-side rendering (SSR/ISR).
# - Bridge network (default compose): http://backend:8000/api/v1
# - If backend runs with network_mode: host: http://127.0.0.1:8001/api/v1
INTERNAL_API_URL=http://backend:8000/api/v1

# CORS / CSRF — comma-separated origins allowed to call the API from a browser.
# Add the production domain(s). Localhost is included by default in dev.
CORS_ALLOWED_ORIGINS=https://test.piligrim30.ru,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://test.piligrim30.ru,http://localhost:3000,http://127.0.0.1:3000

# Security: set exact Nginx/Docker gateway addresses after inspecting the server.
# Never trust 0.0.0.0/0 or ::/0. Nginx must overwrite X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
# Separate key namespace is used even when sharing the Redis instance.
SECURITY_REDIS_URL=redis://redis:6379/0
CHAT_IP_DAILY_LIMIT=150
CHAT_GLOBAL_DAILY_LIMIT=1000
CHAT_MAX_CONCURRENT=6
# Local HTTP development: False. Both must be True behind production HTTPS Nginx.
SECURE_COOKIES=False
TRUST_PROXY_HTTPS=False
