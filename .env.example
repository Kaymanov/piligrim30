# Database Settings
POSTGRES_DB=piligrim_db
POSTGRES_USER=piligrim_user
POSTGRES_PASSWORD=piligrim_pass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Django Settings
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Redis
REDIS_URL=redis://redis:6379/0

# Email Settings (for lead notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=example@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True
LEAD_NOTIFICATION_EMAIL=example@gmail.com

# AI Lawyer (Polza.ai — OpenAI-compatible)
POLZA_API_KEY=your-polza-api-key
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_MODEL=google/gemma-4-26b-a4b-it

# Frontend Settings (Optional variables used by Next.js if needed)
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
